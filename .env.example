# OpenAI: Realtime для разговора и structured outputs для анализа транскрипта
OPENAI_API_KEY=sk-...

# Модель анализа транскрипта. Значение выбирается по живому списку моделей
# (задача 14 плана) и записывается в docs/realtime-probe-findings.md.
OPENAI_ANALYSIS_MODEL=

# Neon Postgres
DATABASE_URL=postgres://...

# Vercel Blob — подставляется автоматически при связывании стора (vercel env pull)
BLOB_READ_WRITE_TOKEN=

# Показывать кандидату ссылку на карточку после интервью. Это демо-поведение:
# в продакшене кандидат карточку не видит.
NEXT_PUBLIC_DEMO_MODE=true
